{
  "name": "a-timeless-journey",
  "version": "0.2.0",
  "private": true,
  "description": "A Timeless Journey - jeu narratif 2D pixel art en vue laterale pour telephone",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:mobile": "tsc --noEmit && vite build --mode capacitor",
    "cap:sync": "npm run build:mobile && cap sync"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
